# TELEGRAM SETTINGS
# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов (через запятую, без пробелов)
ADMINS=123456789

# AMNEZIA WIREGUARD SETTINGS
# Данные для подключения к серверу Amnezia (если бот и VPN на одном сервере - 127.0.0.1)
AMNEZIA_HOST=127.0.0.1
AMNEZIA_PORT=22
AMNEZIA_USER=root
AMNEZIA_PASSWORD=your_root_password
AMNEZIA_SERVICE_NAME=wireguard

# VPN SETTINGS (Amnezia WireGuard)
# Префикс для имен конфигурационных файлов
CONFIGS_PREFIX=myvpn

# DNS сервер (по умолчанию 8.8.8.8)
PEER_DNS=8.8.8.8

# PAYMENT SETTINGS
# Номер карты для оплаты (скриншоты платежей)
PAYMENT_CARD=0000 0000 0000 0000

# Цена месячной подписки в рублях
BASE_SUBSCRIPTION_MONTHLY_PRICE_RUBLES=299

# DATABASE SETTINGS
# Параметры базы данных PostgreSQL
DATABASE=vpnbot
DB_USER=vpnuser
DB_USER_PASSWORD=vpnpass
DB_HOST=localhost
DB_PORT=5432

# GROUP SETTINGS (опционально)
# ID Telegram группы, обязательной для подписки
# REQUIRED_GROUP_ID=-1001234567890

# ADVANCED
# Параметры обфускации AmneziaWG 2.0 (по умолчанию)
OBFUSCATION_JC=5
OBFUSCATION_JMIN=320
OBFUSCATION_JMAX=795
OBFUSCATION_S1=14
OBFUSCATION_S2=117
OBFUSCATION_S3=64
OBFUSCATION_S4=11
OBFUSCATION_H1=646561924-646573803
OBFUSCATION_H2=1946678917-1946711958
OBFUSCATION_H3=2485102049-2485121055
OBFUSCATION_H4=3974564915-3974609527
OBFUSCATION_I1=<b 0xc3000000011367b46e67578c05c2fcb734cf9bed45ff4c8cce0288f60082699e76><rc 14><t><r 1000><r 201>
OBFUSCATION_I2=<b 0xc20000000108fc7b0c89c6d2ee58096efa819b42b372c2de11be120f5c964f4950418e00c805ca82431faca9ea68><rc 14><t><r 1000><r 186>
OBFUSCATION_I3=<b 0xc3000000010c885286dd36f1b50b27518dd50d493fb82f818aa6c5d96db7da130058089bb3><rc 19><t><r 1000><r 191>
